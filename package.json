{
  "name": "@korbash/focus-layout",
  "version": "0.1.0",
  "description": "Renderer-independent graph exploration, focus layouts and interruptible transitions powered by WebCola",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "DESIGN.md",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/korbash/focus-layout.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build:demo": "tsc -p tsconfig.demo.json && vite build",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build:demo && npm run test:e2e",
    "prepack": "npm run build"
  },
  "dependencies": {
    "webcola": "3.4.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "@playwright/test": "1.63.0"
  }
}
